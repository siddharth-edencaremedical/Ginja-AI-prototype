{
  "name": "@ginja/design-system",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./assets": {
      "types": "./src/assets/index.ts",
      "default": "./src/assets/index.ts"
    },
    "./assets/logo": {
      "types": "./src/assets/logo.ts",
      "default": "./src/assets/logo.ts"
    },
    "./assets/logo-mark": {
      "types": "./src/assets/logo-mark.ts",
      "default": "./src/assets/logo-mark.ts"
    },
    "./styles.css": "./src/styles/globals.css"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
