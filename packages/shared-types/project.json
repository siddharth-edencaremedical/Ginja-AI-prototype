{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "shared-types",
  "projectType": "library",
  "sourceRoot": "packages/shared-types/src",
  "tags": ["type:platform", "scope:shared-types"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/shared-types"],
      "options": {
        "command": "tsc -p packages/shared-types/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/shared-types/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"packages/shared-types/**/*.{ts,tsx,js,jsx}\""
      }
    }
  }
}
