{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "auth",
  "projectType": "library",
  "sourceRoot": "packages/auth/src",
  "tags": ["type:platform", "scope:auth"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/auth"],
      "options": {
        "command": "tsc -p packages/auth/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/auth/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"packages/auth/**/*.{ts,tsx,js,jsx}\""
      }
    }
  }
}
