{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "logging",
  "projectType": "library",
  "sourceRoot": "packages/logging/src",
  "tags": ["type:platform", "scope:logging"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/logging"],
      "options": {
        "command": "tsc -p packages/logging/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/logging/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"packages/logging/**/*.{ts,tsx,js,jsx}\""
      }
    }
  }
}
