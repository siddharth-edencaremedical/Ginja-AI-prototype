{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api-client",
  "projectType": "library",
  "sourceRoot": "packages/api-client/src",
  "tags": ["type:platform", "scope:api-client"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/api-client"],
      "options": {
        "command": "tsc -p packages/api-client/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/api-client/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"packages/api-client/**/*.{ts,tsx,js,jsx}\""
      }
    }
  }
}
