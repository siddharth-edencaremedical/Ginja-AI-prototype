{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "underwriting",
  "projectType": "application",
  "sourceRoot": "apps/underwriting/src",
  "tags": ["type:vertical", "scope:underwriting"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/underwriting"],
      "options": {
        "cwd": "apps/underwriting",
        "command": "rsbuild build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/underwriting",
        "command": "rsbuild dev"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/underwriting/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"apps/underwriting/**/*.{ts,tsx,js,jsx}\""
      }
    }
  }
}
