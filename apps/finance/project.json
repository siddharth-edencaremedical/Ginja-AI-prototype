{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "finance",
  "projectType": "application",
  "sourceRoot": "apps/finance/src",
  "tags": ["type:vertical", "scope:finance"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/finance"],
      "options": {
        "cwd": "apps/finance",
        "command": "rsbuild build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/finance",
        "command": "rsbuild dev"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/finance/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"apps/finance/**/*.{ts,tsx,js,jsx}\""
      }
    }
  }
}
