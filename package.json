{
  "name": "ginja-ai-prototype",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build --all",
    "typecheck": "nx run-many -t typecheck --all",
    "lint": "nx run-many -t lint --all",
    "dev:worker": "nx serve cloudflare-worker",
    "dev:shell": "nx serve shell",
    "dev:product-config": "nx serve product-config",
    "dev:underwriting": "nx serve underwriting",
    "cf:migrate:remote-registry": "CI=1 wrangler d1 migrations apply REMOTE_REGISTRY --remote",
    "cf:migrate:remote-registry:local": "CI=1 wrangler d1 migrations apply REMOTE_REGISTRY --local",
    "cf:deploy:shell": "node scripts/cloudflare/deploy-shell.mjs",
    "cf:release:remote": "node scripts/cloudflare/remote-release.mjs",
    "cf:smoke:remote": "node scripts/cloudflare/smoke-remote.mjs",
    "cf:activate:remote": "node scripts/cloudflare/remote-activate.mjs",
    "cf:rollback:remote": "node scripts/cloudflare/remote-activate.mjs",
    "cf:validate:rollback:remote": "node scripts/cloudflare/remote-validate-rollback.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260608.1",
    "@eslint/js": "^9.39.1",
    "@module-federation/runtime-tools": "^2.5.0",
    "@nx/eslint-plugin": "^22.0.0",
    "@nx/workspace": "^22.0.0",
    "@rsbuild/core": "^2.0.1",
    "@rsbuild/plugin-react": "^2.0.1",
    "@rsbuild/plugin-tailwindcss": "^2.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.1",
    "globals": "^16.0.0",
    "nx": "^22.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "wrangler": "^4.98.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "react-router-dom": "^7.9.0"
    }
  }
}
